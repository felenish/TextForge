<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>TextForge.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TextForge.Api\TextForge.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="TextForge.ico" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Detect Node.js install dir; override via /p:NodeJsDir=... if needed -->
    <NodeJsDir Condition="'$(NodeJsDir)' == '' AND Exists('$(ProgramW6432)\nodejs')">$(ProgramW6432)\nodejs</NodeJsDir>
    <NodeJsDir Condition="'$(NodeJsDir)' == '' AND Exists('$(ProgramFiles)\nodejs')">$(ProgramFiles)\nodejs</NodeJsDir>
  </PropertyGroup>

  <Target Name="BuildReactApp" BeforeTargets="Build" Condition="'$(CI)' != 'true' AND '$(SkipBuildReactApp)' != 'true'">
    <Message Text="Building React app (Node: $(NodeJsDir))..." Importance="high" />
    <Exec Command="$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;$env:PATH = '$(NodeJsDir)' + ';' + $env:PATH; &amp; '$(NodeJsDir)\npm.cmd' install --prefer-offline; &amp; '$(NodeJsDir)\npm.cmd' run build&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\ui\textforge-ui" />
  </Target>

</Project>
