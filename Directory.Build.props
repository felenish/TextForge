<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.2</Version>
    <AssemblyVersion>0.1.2.0</AssemblyVersion>
    <FileVersion>0.1.2.0</FileVersion>
    <Product>TextForge Studio</Product>
    <Company>TextForge</Company>
    <Copyright>Copyright © 2026 TextForge</Copyright>
  </PropertyGroup>

  <!-- Strict warnings-as-errors for the domain and storage layers -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TextForge.Core' or
                             '$(MSBuildProjectName)' == 'TextForge.Storage' or
                             '$(MSBuildProjectName)' == 'TextForge.Versioning'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>

</Project>
