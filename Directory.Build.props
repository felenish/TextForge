<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Strict warnings-as-errors for the domain and storage layers -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TextForge.Core' or
                             '$(MSBuildProjectName)' == 'TextForge.Storage' or
                             '$(MSBuildProjectName)' == 'TextForge.Versioning'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>

</Project>
